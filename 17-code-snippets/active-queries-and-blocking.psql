-- ============================================================================
-- active-queries-and-blocking.psql
-- ============================================================================
-- Description:  Live monitor of pg_stat_activity showing active queries,
--               wait events, and blocking hierarchies. Uses \watch to refresh
--               every 2 seconds (Ctrl+C to stop).
-- Requirements: PostgreSQL 9.6+ (pg_blocking_pids added in 9.6).
-- Usage:        psql -h localhost -U postgres -d mydb -f thisfile.psql
--               Or inside psql:  \i active-queries-and-blocking.psql
-- ============================================================================

\pset footer off
\pset null '∅'
\x auto
\echo 'Watching active queries and blockers ... (Ctrl+C to stop)'

SELECT
    now() AS snapshot_time,
    pid,
    usename,
    application_name,
    client_addr,
    state,
    wait_event_type || '.' || wait_event AS wait,
    pg_blocking_pids(pid) AS blocked_by,
    substr(query, 1, 100) AS query_snippet,
    age(clock_timestamp(), query_start) AS duration
FROM pg_stat_activity
WHERE state <> 'idle'
  AND pid <> pg_backend_pid()
ORDER BY query_start NULLS LAST;

\watch 2